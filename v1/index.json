          "url": "https://raw.githubusercontent.com/nginxui/plugin-dns01/main/docs/screenshots/4-provider-fields.png",
          "caption": {
            "en": "Each provider asks only for the fields it needs",
            "zh_CN": "每家服务商只需填写它需要的字段",
            "zh_TW": "每家服務商只需填寫它需要的欄位",
            "ja_JP": "プロバイダーごとに必要な項目だけを入力"
          }
        }
