    {
      "id": "com.nginxui.log-analytics",
      "name": {
        "en": "Log Analytics",
        "ja_JP": "ログ分析",
        "zh_CN": "日志分析",
        "zh_TW": "日誌分析"
      },
      "description": {
        "en": "Search nginx access and error logs with structured queries and see traffic on a dashboard with a visitor map. Provides the former Advanced Indexing feature.",
        "ja_JP": "Nginx のアクセスログとエラーログを構造化検索し、ダッシュボードと訪問者マップでトラフィックを確認します。以前の「高度なインデックス作成」機能を提供します。",
        "zh_CN": "对 Nginx 访问日志和错误日志做结构化搜索，在面板和访客地图上查看流量。提供原“高级索引”功能。",
        "zh_TW": "對 Nginx 存取日誌和錯誤日誌做結構化搜尋，在面板和訪客地圖上檢視流量。提供原「進階索引」功能。"
      },
      "author": "nginx-ui",
      "repository_url": "https://github.com/nginxui/plugin-log-analytics",
      "readme_url": "https://raw.githubusercontent.com/nginxui/plugin-log-analytics/main/README.md",
