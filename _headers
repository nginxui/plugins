# Cloudflare Pages headers. The catalog and the keyring are polled by hosts,
# a short cache keeps revocations moving; schemas change with releases only.
# The pages show text from plugin authors, so they run no inline script and
# load nothing but their own files, https images and the Cloudflare Web
# Analytics beacon that Pages injects.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self'; img-src 'self' https:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
/v1/*
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff
/v1/*.minisig
  Content-Type: text/plain; charset=utf-8
/assets/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
/schema/*
  Cache-Control: public, max-age=86400
  Content-Type: application/schema+json; charset=utf-8
