      "manifest": {
        "id": "com.nginxui.dns01",
        "name": "DNS-01 Challenge",
        "version": "1.0.0",
        "description": "Validate domains for certificates through DNS records, with more than 200 DNS providers.",
        "icon_path": "webapp/dist/icon.svg",
        "api_version": 1,
        "min_nginx_ui_version": "2.7.0",
        "server": {
          "executables": {
            "darwin-amd64": "server/dist/dns01-darwin-amd64",
            "darwin-arm64": "server/dist/dns01-darwin-arm64",
            "linux-amd64": "server/dist/dns01-linux-amd64",
            "linux-arm64": "server/dist/dns01-linux-arm64",
            "windows-amd64": "server/dist/dns01-windows-amd64.exe",
            "windows-arm64": "server/dist/dns01-windows-arm64.exe"
          },
          "lifecycle": "on_demand",
          "idle_timeout_seconds": 300
        },
        "webapp": {
          "bundle_path": "webapp/dist/main.js",
          "style_path": "webapp/dist/style.css",
          "shared": {
            "@vueuse/core": ">=15.0.0",
            "antdv-next": "~1.5",
            "pinia": ">=4.0.3 <5",
            "vue": ">=3.5.42 <4",
            "vue-router": ">=5.3.1 <6"
          }
        },
        "capabilities": [
          "dns01"
        ],
        "permissions": [
          "network"
        ],
        "settings_schema": {
          "settings": [
            {
              "key": "recursive_nameservers",
              "type": "text",
              "display_name": "Recursive nameservers",
              "help_text": "Comma separated host:port list used for the DNS propagation check. Empty means the system resolvers."
            },
            {
              "key": "default_propagation_timeout_seconds",
              "type": "number",
              "display_name": "Default propagation timeout (seconds)",
              "help_text": "Applied to providers that do not report a propagation timeout of their own.",
              "default": 120
            }
          ]
        }
      }
    }
  ]
